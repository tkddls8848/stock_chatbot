# 저장소 루트 .env 하나에서 봇·웹·쇼츠 설정을 관리합니다.
# 실제 .env는 Git에 넣지 않습니다. 기존 파일에는 필요한 키만 추가하세요.
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
# 명령을 받을 chat_id(쉼표 구분). 비면 기동하지 않는다 — 빈 값을 전체 허용으로
# 읽으면 봇 사용자명을 아는 누구나 상태를 고치고 Neurons를 태울 수 있다.
ALLOWED_CHAT_IDS=<notification chat or channel ID>

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 번역·분석 공용. Cloudflare가 폐기·개명하면 코드 배포 없이 바로 바꿔야
# 하므로(config.py 주석 참고) 예외적으로 env에 남긴다.
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 현재 Polymarket 웹 대시보드. 지역 차단(451)에 막힐 때만 proxy를 채운다.
POLYMARKET_PROXY_URL=
# 수집 제외 기준이 아니라 화면의 데이터 품질 배지를 가르는 USD 기준이다.
POLYMARKET_WEB_LOW_LIQUIDITY=1000

# 공유 저장소(NAS) 경로. 비우면 저장소 루트의 storage/. 봇·웹·one-shot·쇼츠가 같은
# 값을 루트 .env 하나에서 읽는다. 한 파일시스템이어야 한다.
STORAGE_DIR=

# Google 로그인. 자격증명이 없으면 리서치·자산 API가 닫힌다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상 난수. 계정 식별용 키이므로 백업하고 임의 교체하지 않는다.
ACCOUNT_IDENTITY_KEY=
# 전체 자산 어드바이저의 외부 시장 자료. 비면 그 항목만 "자료 없음"으로 둔다.
FSS_API_KEY=
ECOS_API_KEY=
MOLIT_API_KEY=

# 쇼츠 설정 (별도 shorts/.env를 만들지 않습니다)
POLYMARKET_WEB_URL=https://nunchi.live
SHORTS_TIMEZONE=Asia/Seoul
SHORTS_MAX_DURATION_SECONDS=150
SHORTS_TARGET_SCRIPT_CHARS=760
SHORTS_MAX_GROUPS=5
# 최근 며칠 안에 영상으로 다룬 이벤트·주제(날짜 변형 포함)는 후보에서 뺀다
SHORTS_REPEAT_DAYS=7
SHORTS_TTS_VOICE=ko-KR-SunHiNeural
SHORTS_TTS_RATE=+0%
SHORTS_VISUALS_ENABLED=true
# 이슈 장면 배경을 그날 이슈로 새로 그린다(Cloudflare Workers AI). 실패하면 저장 배경.
SHORTS_GENERATED_BACKGROUNDS=true
SHORTS_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# 그린 배경에 사람·글자가 있으면 다시 그린다(최대 3번, 끝까지 걸리면 저장 배경)
SHORTS_BACKGROUND_CHECK=true
SHORTS_VISION_MODEL=@cf/llava-hf/llava-1.5-7b-hf
# 선택 기능: 만든 이슈 PNG를 fal Seedance 무음 클립으로 확장. 키가 비면 정지 유지.
SHORTS_GENERATED_CLIPS=false
SHORTS_VIDEO_MODEL=bytedance/seedance-2.0/fast/image-to-video
SHORTS_VIDEO_API_KEY=
SHORTS_CLIP_SECONDS=8
SHORTS_FONT_FILE=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 비우거나 생략하면 PATH·Windows 기본 설치 경로 탐색
BLENDER_BIN=

# 이슈 선별·원고 작성·자연어 편집: Cloudflare Workers AI 권한이 있는 계정/API 토큰
SHORTS_EDITOR_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 타입캐스트
SHORTS_TYPECAST_API_KEY=

# 검수 완료본 YouTube 업로드. 최초 승인은 --youtube-auth (운영자 PC).
SHORTS_YOUTUBE_CLIENT_ID=
SHORTS_YOUTUBE_CLIENT_SECRET=
SHORTS_YOUTUBE_REFRESH_TOKEN=
SHORTS_YOUTUBE_PRIVACY=private
SHORTS_YOUTUBE_CATEGORY_ID=25
