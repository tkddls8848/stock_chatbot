# 저장소 루트 .env 하나에 봇·웹·쇼츠의 비밀값과 배포 경로만 둡니다. Git에 넣지 않습니다.
# 모델·주기·공개 범위 같은 조정값은 각 모듈의 config.py 상수입니다(바꾸면 git에 남습니다).

# 텔레그램
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
# 명령을 받을 chat_id(쉼표 구분). 비면 기동하지 않는다.
ALLOWED_CHAT_IDS=<notification chat or channel ID>

# Cloudflare Workers AI (봇·웹·쇼츠 공용)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKER_AI_API_TOKEN=
# 번역·분석 모델. Cloudflare가 폐기·개명하면 배포 없이 바로 바꿔야 해서 예외로 env에 둔다.
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# 웹 뷰 검증(/research)만 쓰는 추론 모델. 같은 이유로 env에 둔다. 비우면 코드의 기본값을 쓴다.
VIEW_CHECK_MODEL=@cf/openai/gpt-oss-120b
# 뷰 검증을 쓸 수 있는 웹 계정 키(storage/users/ 아래 폴더 이름, 쉼표로 여럿). 운영자 개인용이라 비면 아무도 못 쓴다.
VIEW_CHECK_ACCOUNT_KEYS=

# 공유 저장소(NAS) 경로. 비우면 저장소 루트의 storage/.
STORAGE_DIR=
# Polymarket이 지역 차단(451)할 때만 채운다.
POLYMARKET_PROXY_URL=

# Google OAuth 클라이언트(웹 애플리케이션) 하나로 웹 로그인과 쇼츠 YouTube 업로드를 함께 한다.
# 리디렉션 URI 두 개를 등록한다: https://nunchi.live/auth/google/callback(웹 로그인),
# http://127.0.0.1:8765/(운영자 PC의 --youtube-auth). 프로젝트에 YouTube Data API v3를 켠다.
# 비면 리서치·자산이 닫히고 쇼츠 업로드가 멈춘다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상 난수. 계정 식별용이므로 백업하고 임의 교체하지 않는다.
ACCOUNT_IDENTITY_KEY=
# 쇼츠: YouTube 업로드 갱신 토큰(위 Google 클라이언트로 --youtube-auth가 발급)
SHORTS_YOUTUBE_REFRESH_TOKEN=

# 쇼츠: ElevenLabs 음성 합성용 API 키. 실제 값은 루트 .env에만 입력한다.
# ElevenLabs를 우선 사용하고 키 누락·크레딧 부족·오류 시 Microsoft SunHi로 전환한다.
# Text to Speech 권한이 필요하다. 음성 검색에만 Voices Read 권한이 추가로 필요하다.
ELEVENLABS_API_KEY=

# 자산 어드바이저 외부 자료. 비면 그 항목만 "자료 없음".
FSS_API_KEY=
ECOS_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 뉴스레터 메일. SMTP_HOST·NEWSLETTER_FROM이 비면 구독 API가 503.
# 465는 SMTPS, 그 밖은 STARTTLS. Gmail이면 smtp.gmail.com·587·앱 비밀번호.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NEWSLETTER_FROM=


