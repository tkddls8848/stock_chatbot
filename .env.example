# 저장소 루트 .env 하나에 봇·웹·쇼츠의 비밀값과 배포 경로만 둡니다. Git에 넣지 않습니다.
# 모델·주기·공개 범위 같은 조정값은 각 모듈의 config.py 상수입니다(바꾸면 git에 남습니다).

# 텔레그램
TELEGRAM_BOT_TOKEN=<BotFather token>
TELEGRAM_CHAT_ID=<notification chat or channel ID>
# 명령을 받을 chat_id(쉼표 구분). 비면 기동하지 않는다.
ALLOWED_CHAT_IDS=<notification chat or channel ID>

# Cloudflare Workers AI (봇·웹·쇼츠 공용)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# 번역·분석 모델. Cloudflare가 폐기·개명하면 배포 없이 바로 바꿔야 해서 예외로 env에 둔다.
CLOUDFLARE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# 공유 저장소(NAS) 경로. 비우면 저장소 루트의 storage/.
STORAGE_DIR=
# Polymarket이 지역 차단(451)할 때만 채운다.
POLYMARKET_PROXY_URL=

# Google 로그인(리디렉션 URI: https://nunchi.live/auth/google/callback). 비면 리서치·자산이 닫힌다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32바이트 이상 난수. 계정 식별용이므로 백업하고 임의 교체하지 않는다.
ACCOUNT_IDENTITY_KEY=

# 자산 어드바이저 외부 자료. 비면 그 항목만 "자료 없음".
FSS_API_KEY=
ECOS_API_KEY=
DATA_GO_KR_SERVICE_KEY=

# 뉴스레터 메일. SMTP_HOST·NEWSLETTER_FROM이 비면 구독 API가 503.
# 465는 SMTPS, 그 밖은 STARTTLS. Gmail이면 smtp.gmail.com·587·앱 비밀번호.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NEWSLETTER_FROM=

# 쇼츠: fal 클립 키(비면 정지 배경), YouTube 업로드 자격증명(최초 승인은 --youtube-auth)
SHORTS_VIDEO_API_KEY=
SHORTS_YOUTUBE_CLIENT_ID=
SHORTS_YOUTUBE_CLIENT_SECRET=
SHORTS_YOUTUBE_REFRESH_TOKEN=
