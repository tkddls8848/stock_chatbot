#!/bin/sh
#
# stock_chatbot Lightsail 부트스트랩.
# cloud-init이 최초 부팅 때 root로 1회 실행한다. 재실행하려면 SSH로 접속해
# `sudo bash /var/lib/cloud/instance/scripts/part-001`을 직접 돌린다.
#
# 이 스크립트는 봇을 **기동하지 않는다.** 이유는 아래 8절 참조.

# **bash 전용 구문을 쓰지 않는다.** Lightsail은 user_data 앞에 자기 초기화
# 스크립트를 붙이고 합쳐진 파일을 `/bin/sh`(dash)로 실행한다. 그래서 위의
# `#!/bin/bash`는 파일 중간의 주석이 되어 무시된다. 2026-08-15에 `set -o pipefail`이
# `Illegal option`으로 죽어 부트스트랩이 통째로 실패했다 — 로그 파일조차 열리기
# 전이라 원인이 `/var/log/cloud-init-output.log`에만 남았다.
# 프로세스 치환 `>(...)`, `[[ ]]`, 배열도 같은 이유로 쓸 수 없다.
set -eu
exec >>/var/log/stock-chatbot-bootstrap.log 2>&1

APP_USER="${app_user}"
APP_DIR="${app_dir}"
REPO_URL="${repo_url}"
REPO_REF="${repo_ref}"
SERVICE_NAME="${service_name}"
SWAP_SIZE="${swap_size}"
TIMEZONE="${timezone}"
BACKUP_RETENTION_DAYS="${backup_retention_days}"

MARKER_DIR=/var/lib/stock-chatbot
mkdir -p $MARKER_DIR

echo "[bootstrap] 시작 $(date -Is)"

# --------------------------------------------------------------------------
# 1) 타임존
#
# 스케줄러가 JST 기준 시각(장중·마감 브리핑)으로 잡을 실행한다.
# UTC로 두면 전부 9시간 어긋난다.
# --------------------------------------------------------------------------
timedatectl set-timezone "$TIMEZONE"
echo "[bootstrap] 타임존=$(timedatectl show -p Timezone --value) 현재시각=$(date)"

# --------------------------------------------------------------------------
# 2) 스왑 — 반드시 pip 설치보다 먼저
#
# 1GB 인스턴스에서 가장 흔한 실패는 pandas 설치 중 OOM kill이다.
# --------------------------------------------------------------------------
if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
  fallocate -l "$SWAP_SIZE" /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  echo "[bootstrap] 스왑 $SWAP_SIZE 활성화"
else
  echo "[bootstrap] 스왑 이미 존재 — 건너뜀"
fi

# --------------------------------------------------------------------------
# 3) 시스템 패키지
# --------------------------------------------------------------------------
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y python3-venv python3-pip git tzdata

# --------------------------------------------------------------------------
# 4) 코드 체크아웃
#
# 비공개 저장소면 여기서 실패한다(부트스트랩은 자격증명을 갖지 않는다).
# 그 경우 이 단계만 SSH로 수동 처리하고 5절부터 이어서 실행한다.
# --------------------------------------------------------------------------
if [ ! -d "$APP_DIR/.git" ]; then
  sudo -u "$APP_USER" git clone --branch "$REPO_REF" "$REPO_URL" "$APP_DIR"
else
  sudo -u "$APP_USER" git -C "$APP_DIR" fetch --all
  sudo -u "$APP_USER" git -C "$APP_DIR" checkout "$REPO_REF"
  sudo -u "$APP_USER" git -C "$APP_DIR" pull --ff-only
fi
echo "[bootstrap] 체크아웃 $(sudo -u $APP_USER git -C $APP_DIR rev-parse --short HEAD)"

# --------------------------------------------------------------------------
# 5) 가상환경
# --------------------------------------------------------------------------
if [ ! -x "$APP_DIR/venv/bin/python" ]; then
  sudo -u "$APP_USER" python3 -m venv "$APP_DIR/venv"
fi
sudo -u "$APP_USER" "$APP_DIR/venv/bin/pip" install --upgrade pip
sudo -u "$APP_USER" "$APP_DIR/venv/bin/pip" install -r "$APP_DIR/requirements.txt"

# 배포 시점의 실제 버전을 남긴다. requirements.txt에 버전 핀이 거의 없어
# 재현이 필요할 때 이 파일이 유일한 근거가 된다.
sudo -u "$APP_USER" bash -c "$APP_DIR/venv/bin/pip freeze > $APP_DIR/requirements.lock.txt"

# --------------------------------------------------------------------------
# 6) 데이터 디렉터리와 .env 골격
#
# 시크릿은 여기서 채우지 않는다(tfstate·user_data에 평문으로 남기지 않기 위해).
# 관리 웹 비밀번호만 무작위로 생성한다 — 사용자가 정할 값이 아니고,
# 기본값 'password'로 방치되는 사고를 막는다.
# --------------------------------------------------------------------------
sudo -u "$APP_USER" mkdir -p "$APP_DIR/data"

if [ ! -f "$APP_DIR/.env" ]; then
  sudo -u "$APP_USER" cp "$APP_DIR/.env.example" "$APP_DIR/.env"
  WEB_ADMIN_PW=$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)
  sed -i "s|^WEB_ADMIN_PASSWORD=.*|WEB_ADMIN_PASSWORD=$WEB_ADMIN_PW|" "$APP_DIR/.env"
  chmod 600 "$APP_DIR/.env"
  chown "$APP_USER:$APP_USER" "$APP_DIR/.env"
  echo "[bootstrap] .env 생성 (WEB_ADMIN_PASSWORD 무작위 설정). 토큰은 수동으로 채운다."
else
  echo "[bootstrap] .env 이미 존재 — 건드리지 않음"
fi

# --------------------------------------------------------------------------
# 7) systemd 유닛
#
# 두 줄이 함정이다.
#  - WorkingDirectory가 저장소 루트가 아니면 ModuleNotFoundError: shared
#    (저장소 루트가 import 루트다)
#  - MPLBACKEND=Agg가 없으면 헤드리스에서 /market 차트가 실패한다
# --------------------------------------------------------------------------
cat > /etc/systemd/system/$SERVICE_NAME.service <<UNIT
[Unit]
Description=Stock Chatbot (Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$APP_USER
WorkingDirectory=$APP_DIR
Environment=PYTHONUNBUFFERED=1
Environment=MPLBACKEND=Agg
ExecStart=$APP_DIR/venv/bin/python -m telegram_bot.main
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
echo "[bootstrap] systemd 유닛 $SERVICE_NAME.service 설치 (기동은 하지 않음)"

# --------------------------------------------------------------------------
# 8) 기동하지 않는 이유 — 의도된 설계
#
# data/runtime/bot.lock은 머신 단위라 다른 호스트의 중복 기동을 막지 못한다.
# 같은 봇 토큰으로 두 프로세스가 getUpdates를 치면 텔레그램이
# `Conflict: terminated by other getUpdates request`를 반환하고 양쪽이 번갈아 죽는다.
# 게다가 .env의 토큰이 아직 비어 있어 지금 켜면 ConfigurationError로 실패한다.
#
# 전환은 반드시 "로컬 봇 정지 → .env 작성 → 서버 기동" 순서로 사람이 한다.
# 명령은 `terraform output cutover_commands` 참조.
# --------------------------------------------------------------------------

# --------------------------------------------------------------------------
# 9) 백업 cron
#
# 상태는 전부 data/ 하위 JSON이고 DB가 없어 tar 하나면 충분하다.
# Lightsail 자동 스냅샷과 별개로, 파일 단위 복구용이다.
# --------------------------------------------------------------------------
cat > /etc/cron.d/stock-chatbot-backup <<CRON
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
# 매일 03:00 JST — Lightsail 자동 스냅샷(04:00 JST)보다 먼저 돌아 스냅샷에 포함된다.
0 3 * * * $APP_USER tar czf /home/$APP_USER/backup-\$(date +\%F).tgz -C $APP_DIR data && find /home/$APP_USER -maxdepth 1 -name 'backup-*.tgz' -mtime +$BACKUP_RETENTION_DAYS -delete
CRON
chmod 644 /etc/cron.d/stock-chatbot-backup
echo "[bootstrap] 백업 cron 등록 (보관 $BACKUP_RETENTION_DAYS일)"

# --------------------------------------------------------------------------
# 10) 완료 표시 — terraform output의 verify 명령이 이 파일을 확인한다
# --------------------------------------------------------------------------
date -Is > $MARKER_DIR/bootstrap-ok
echo "[bootstrap] 완료 $(date -Is)"
