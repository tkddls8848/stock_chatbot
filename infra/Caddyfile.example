# Caddy는 TLS와 인증을 처리하고, 내부 전용 웹 프로세스에만 프록시한다.
# 첫 줄을 실제 도메인으로 바꾸고 PASSWORD_HASH를 `caddy hash-password` 출력으로
# 교체한다. `http://` 접두사는 쓰지 않는다 — 붙이면 자동 HTTPS가 꺼진다.
# 지시어는 `basicauth`다(`basic_auth`가 아니다) — 공유 호스트의 Caddy는 우분투
# 기본 저장소판 2.6.2이고, `basic_auth`는 2.8부터다. 2.6에서는 파싱에 실패한다.
# 절차는 infra/server-ops.md 11절.
#
# 면을 나눈다: 시장 컨센서스와 현재 Polymarket 전체 대시보드는 열고,
# 종목명·액션·confidence가 들어가는 리서치만 잠근다. noindex는 모두에 붙인다 — 열람은 자유롭게 두되
# 검색 결과에는 쌓지 않는다. **검색 크롤러 자체는 막지 않는다**: 막으면 크롤러가
# noindex를 읽지 못해 URL만 색인에 남을 수 있다. 막는 것은 부하를 만드는 /api/ 면과
# AI 수집 봇뿐이고, 그 목록은 앱의 robots.txt(web/pages/robots.py)와 아래 @aibots가
# 나눠 갖는다 — robots.txt는 권고라 지키는 봇에만 듣고, 무시하는 봇은 여기서 끊긴다.
# 두 목록은 같이 고친다.
example.com {
    # Tailscale Serve가 tailnet IP의 443을 사용하므로 Lightsail 사설 NIC만 바인딩한다.
    # 이 줄을 빼면 0.0.0.0:443을 잡으려다 EADDRINUSE로 기동하지 못한다.
    bind PRIVATE_IP
    encode zstd gzip

    header X-Robots-Tag "noindex, nofollow"

    # BEGIN aibots — infra/scripts/apply-caddy-bots.sh 가 이 두 줄 사이를 통째로
    # 호스트의 /etc/caddy/Caddyfile 에 옮긴다. 손으로 옮기면 견본과 실제 설정이
    # 갈라지고, 갈라진 것을 알아챌 방법이 없다. 표식을 지우지 않는다.
    # AI 학습·수집 봇은 프록시로 넘기기 전에 끊는다. abort는 응답을 만들지 않아
    # (403을 쓰는 것보다) 자원을 가장 적게 쓴다. UA는 봇이 자칭하는 문자열이라
    # 위장한 봇은 잡지 못한다 — 그것까지 막으려면 IP 단위 rate limit이 필요한데,
    # 우분투 저장소판 Caddy 2.6.2에는 없어 플러그인을 넣어 다시 빌드해야 한다.
    # 배포가 파일 복사로 끝나는 지금 구조를 깨므로 여기서는 하지 않는다.
    # 목록은 web/pages/robots.py의 AI_AGENTS와 같다. 한쪽만 고치지 않는다.
    @aibots header_regexp User-Agent "(?i)(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|CCBot|Google-Extended|PerplexityBot|Bytespider|Amazonbot|meta-externalagent|FacebookBot|Applebot-Extended|cohere-ai|Diffbot|ImagesiftBot|Omgilibot|YouBot|Timpibot|AhrefsBot|SemrushBot|MJ12bot|DotBot|DataForSeoBot)"
    abort @aibots
    # END aibots

    @research path /research /research/* /api/research /api/research/*
    basicauth @research {
        friend PASSWORD_HASH
    }

    reverse_proxy 127.0.0.1:8788
}
