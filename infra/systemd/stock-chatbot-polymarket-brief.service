[Unit]
Description=Build Polymarket sector consensus paragraphs
After=stock-chatbot-polymarket-refresh.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/stock-chatbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/stock-chatbot/venv/bin/python -m services.web.polymarket.sector_brief
Nice=10
CPUWeight=20
MemoryMax=384M
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
