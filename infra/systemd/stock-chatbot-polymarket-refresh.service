[Unit]
Description=Refresh current Polymarket dashboard generation
After=network-online.target
Wants=network-online.target
OnSuccess=stock-chatbot-polymarket-brief.service

[Service]
Type=oneshot
User=stockbot
Group=stockbot
WorkingDirectory=/srv/stock-chatbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/stock-chatbot/venv/bin/python -m web.polymarket.refresh
Nice=10
CPUWeight=20
MemoryMax=384M
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
