.env
.env*
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.test-tmp/
.mypy_cache/
.ruff_cache/

data/*/*.json
data/*/*.jsonl
!data/.gitkeep
data/runtime/bot.lock
data/yfinance_cache/

*.log
*.tmp

# 영상 제작 스킬 번들(heygen-com/hyperframes). 이 저장소 코드가 아니고
# .claude/skills의 심볼릭 링크가 절대경로라 다른 기계에서 전부 깨진다.
.agents/
.claude/
skills-lock.json

# 쇼츠(shorts/)는 자기 venv와 배포 유닛을 가진 별개 패키지이지만 소스는 이
# 저장소에서 추적한다. 렌더 산출물과 빌드 부산물은 shorts/.gitignore가 막는다.
shorts/.venv/
shorts/output/
shorts/state/

# stockbot 서비스 계정의 HOME이 이 저장소 루트라, 홈 디렉토리 설정이 작업
# 트리 안에 생긴다. `.config/gh/hosts.yml`에는 GitHub 토큰이 평문으로 들어
# 있다 — `git add -A` 한 번에 자격증명이 커밋되지 않도록 여기서 막는다.
/.config/
/.gitconfig
/.lesshst
/.cache/

# 앱 인프라 스크립트의 로컬 값 덮어쓰기 (infra/scripts/lib.sh 가 읽는다)
infra/scripts/config.env
