.env
.env*
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.test-tmp/
.mypy_cache/
.ruff_cache/

# 공유 저장소(NAS). 실행 중 생기는 데이터 전부이고 추적하지 않는다.
# 디렉터리 자리만 .gitkeep으로 남긴다 — 받자마자 어디에 쌓이는지 보이게 한다.
# 옛 data/는 서버에서 storage/로 한 번 옮긴다(infra/server-ops.md 9-1).
/storage/*
!/storage/.gitkeep
/data/

*.log
*.tmp

# 영상 제작 스킬 번들(heygen-com/hyperframes). 이 저장소 코드가 아니고
# .claude/skills의 심볼릭 링크가 절대경로라 다른 기계에서 전부 깨진다.
.agents/
.claude/
skills-lock.json

# 쇼츠(shorts/)는 자기 venv와 배포 유닛을 가진 별개 패키지이지만 소스는 이
# 저장소에서 추적한다. 렌더 산출물과 빌드 부산물은 shorts/.gitignore가 막는다.
shorts/.venv/
shorts/output/
shorts/state/

# 예전 stockbot 서비스 계정은 HOME이 이 저장소 루트라 홈 디렉토리 설정이 작업
# 트리 안에 생겼다. 지금은 ubuntu 계정(HOME=/home/ubuntu)으로 돌지만, 그때 생긴
# 파일이 서버 체크아웃에 남아 있을 수 있다. `.config/gh/hosts.yml`에는 GitHub 토큰이
# 평문으로 들어 있다 — `git add -A` 한 번에 자격증명이 커밋되지 않도록 계속 막는다.
/.config/
/.gitconfig
/.lesshst
/.cache/

# 앱 인프라 스크립트의 로컬 값 덮어쓰기 (infra/scripts/lib.sh 가 읽는다)
infra/scripts/config.env
